{
  "opencollection": "1.0.0",
  "info": {
    "name": "D-ID Agents Voices API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Voices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List voices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.d-id.com/tts/voices",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "query",
                "description": "Filter by voice provider."
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Filter by voice ID (unique per provider)."
              }
            ]
          },
          "docs": "Retrieve available TTS voices, optionally filtered by provider or voice ID."
        }
      ]
    }
  ],
  "bundled": true
}