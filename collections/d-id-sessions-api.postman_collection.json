  "info": {
    "_postman_id": "bf6417ce-6d7b-4198-9c2d-0e92ed3afd52",
    "name": "D-ID Agents Sessions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "API for creating and managing interactive real-time AI agents that combine digital avatar streaming with large language models, RAG-based knowledge bases, and custom tools. Supports WebRTC and LiveKit-powered streaming sessions, conversation memory, chat export, and integration with third-party LLM providers. Enables face-to-face AI conversations at scale.\n",
      "type": "text/plain"
    }
  }
